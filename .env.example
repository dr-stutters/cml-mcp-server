# Copy to .env (git-ignored, chmod 600) and fill in.
# --- Cisco Modeling Labs controller ---
CML_URL=https://cml.example.com
CML_USERNAME=
CML_PASSWORD=
# Or a pre-issued JWT instead of username/password:
# CML_TOKEN=
CML_VERIFY_SSL=true
# CML_CA_BUNDLE=/path/to/ca.pem
# CML_TIMEOUT=30
# CML_RETRIES=2
# CML_WAIT_TIMEOUT=600          # default wait for start/stop/convergence (seconds)
# Recipe secrets: recipes reference ${LAB_*}; values from LAB_* env vars or this dotenv file
# CML_LAB_SECRETS_FILE=~/MCP-Suite/lab-secrets.env
# Least-privilege test accounts (scripts/seed_lab.py --least-privilege, tests/live/test_least_privilege.py)
# CML_RO_USERNAME=mcp-cml-viewer
# CML_RO_PASSWORD=
# CML_RW_USERNAME=mcp-cml-operator
# CML_RW_PASSWORD=

# --- MCP server ---
# MCP_TRANSPORT=stdio           # or http
# MCP_PORT=8000
# MCP_AUTH_TOKENS=              # required for http: name:sha256:<hex> (cml-mcp-server token <name>)
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# LOG_LEVEL=INFO
