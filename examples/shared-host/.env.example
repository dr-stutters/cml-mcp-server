# Shared-host settings for examples/shared-host (docs/deploying.md). Copy to .env, chmod 600, never commit it.

# Image: pin a version on a shared host (latest / rc also exist)
MCP_IMAGE_TAG=latest

# TLS (Caddy): the name clients use, and "internal" or your ACME e-mail address
MCP_HOSTNAME=mcp-cml.example.com
CADDY_TLS=internal

# The default CML controller and the server's own regular (non-admin) account (docs/least-privilege.md).
# One CML account per server instance; never the built-in admin.
CML_URL=https://cml.example.com
CML_USERNAME=mcp-cml-viewer
CML_PASSWORD=
# CML_PASSWORD_FILE=/run/secrets/cml_password   # preferred: a Docker secret instead of a value here
# CML_CA_BUNDLE=/certs/cml-ca.pem
# CML_CONSOLE_KNOWN_HOSTS=/certs/known_hosts     # console server host key (cml_run_commands, SSH port 22)

# More controllers (optional): each has its own URL, account and TLS settings
# CML_INSTANCES=training
# CML_TRAINING_URL=https://cml-training.example.com
# CML_TRAINING_USERNAME=mcp-cml-viewer
# CML_TRAINING_PASSWORD=
# CML_TRAINING_READ_ONLY=true

# One token per person: cml-mcp-server token <name>, then paste the name:sha256:<hex> lines here
MCP_AUTH_TOKENS=

# Read-only unless you opt in. With writes on, MCP_ROLES decides who may use them (ro / rw / admin).
# MCP_ENABLE_WRITES=false
# MCP_ENABLE_DANGEROUS=false
# MCP_ROLES=alice:rw,bob:ro
